NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# RAG (base de conhecimento). Opcional — sem EMBEDDINGS_API_KEY o RAG fica
# desativado (a sugestão de IA usa só o contexto regional). O modelo deve gerar
# 1536 dimensões (text-embedding-3-small) para casar com a coluna VECTOR(1536).
EMBEDDINGS_API_KEY=
EMBEDDINGS_BASE_URL=https://api.openai.com/v1
EMBEDDINGS_MODEL=text-embedding-3-small
RESEND_API_KEY=re_xxxxxxxxxxxx
AUTH_EMAIL_FROM="PlanoCerto <acesso@seudominio.com.br>"
AUTH_EMAIL_REPLY_TO=suporte@seudominio.com.br
# E2E (Playwright) — opcional. Sem estas, os testes autenticados são pulados.
# Use um usuário de teste descartável; nunca commite credenciais reais.
# Rodar: npx playwright install chromium && npm run test:e2e
E2E_EMAIL=
E2E_PASSWORD=
# E2E_BASE_URL=http://localhost:3000
